# Base URL backend FastAPI (tanpa trailing slash).
# Lokal: http://localhost:7860 | Produksi: URL Hugging Face Space, mis.
# https://<user>-<space>.hf.space
NEXT_PUBLIC_BASE_API_URL=http://localhost:7860

# Sumber hasil prediksi:
#   backend = selalu memanggil backend, error ditampilkan apa adanya
#   mock    = hasil palsu dari FE (backend tidak dipanggil), UI menampilkan
#             badge "MODE MOCK". Tidak ada fallback otomatis ke mock.
NEXT_PUBLIC_API_MODE=backend

# (Opsional) URL publik situs untuk metadata OpenGraph. Di Vercel otomatis
# memakai VERCEL_PROJECT_PRODUCTION_URL bila kosong.
# NEXT_PUBLIC_SITE_URL=https://meja-bersih.vercel.app
